---
source: crates/page/tests/corpus.rs
expression: "dumps(&page, &list)"
---
== dom ==
#document
  #doctype html
  html
    head
      title
        "Margin collapsing"
      "\n"
      style
        "\n  body { margin: 0; font-family: sans-serif; font-size: 16px; line-height: 20px }\n  div, p { background: #eef }\n  .a { margin: 20px 0 }\n  .b { margin: 30px 0 }\n  .parent { margin-top: 10px; background: #fee }\n  .child { margin-top: 25px }\n  .border { border-top: 1px solid black; margin-top: 10px }\n  .border .child { margin-top: 15px }\n  .empty { margin: 12px 0 18px }\n  .neg { margin-top: -8px }\n  .pad { padding-top: 1px; margin-top: 10px }\n  .pad .child { margin-top: 40px }\n"
      "\n"
    body
      p class="a"
        "siblings: max(20, 30) between"
      "\n"
      p class="b"
        "second sibling"
      "\n"
      div class="parent"
        p class="child"
          "child margin collapses through the parent"
      "\n"
      div class="border"
        p class="child"
          "a border stops it"
      "\n"
      div class="empty"
      "\n"
      p class="neg"
        "an empty block's margins collapse through it, then a negative one"
      "\n"
      div class="pad"
        p class="child"
          "padding stops it too"
      "\n"

