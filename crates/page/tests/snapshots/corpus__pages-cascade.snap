== dom ==
#document
  #doctype html
  html
    head
      title
        "Cascade and selectors"
      "\n"
      link rel="stylesheet" href="cascade.css"
      "\n"
      style
        "\n  p { color: blue }\n  #id { color: green }\n  .later { color: purple }\n  .important { color: orange !important }\n"
      "\n"
    body
      div class="box"
        "\n  "
        p
          "type selector: blue from the inline sheet beats the linked red (same specificity, later)"
        "\n  "
        p id="id" class="cls"
          "id beats class"
        "\n  "
        p class="cls later"
          "two classes in source order: purple"
        "\n  "
        p class="important" style="color: black"
          "important beats the style attribute"
        "\n  "
        p style="color: teal"
          "the style attribute beats the sheets"
        "\n  "
        p data-kind="attr"
          "attribute selector"
        "\n  "
        p lang="fr-CA"
          "attribute prefix and dash match"
        "\n  "
        span
          "a span"
        " "
        span class="sib"
          "adjacent sibling"
        " "
        span
          "general sibling"
        "\n  "
        ul
          li
            "first"
          li
            "middle"
          li
            "last"
        "\n  "
        p class="not-me"
          ":not() skips this"
        "\n  "
        section
          div
            em
              "descendant"
          em
            "child"
        "\n"
      "\n"

