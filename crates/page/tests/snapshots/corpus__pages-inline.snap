== dom ==
#document
  #doctype html
  html
    head
      title
        "Inline formatting"
      "\n"
      style
        "\n  body { margin: 8px; width: 300px; font-family: serif; font-size: 16px }\n  .big { font-size: 28px }\n  .small { font-size: 10px }\n  .box { background: #fe8; border: 2px solid #c80; padding: 0 4px }\n  .ib { display: inline-block; width: 60px; height: 30px; background: #8cf; vertical-align: middle }\n  .pre { white-space: pre; font-family: monospace }\n  .nowrap { white-space: nowrap }\n  .center { text-align: center }\n  .right { text-align: right }\n  .indent { text-indent: 20px }\n  u { text-decoration: underline }\n"
      "\n"
    body
      p
        "Words wrap at spaces across "
        span class="big"
          "larger"
        " and "
        span class="small"
          "smaller"
        " text, and the line box grows to hold the tallest."
      "\n"
      p
        "An "
        span class="box"
          "inline box with a border and padding that splits across lines"
        " keeps its edges on the first and last fragment."
      "\n"
      p
        "Before "
        span class="ib"
        " an inline block sits on the baseline."
      "\n"
      p class="pre"
        "pre  keeps   spaces\nand newlines"
      "\n"
      p class="nowrap"
        "nowrap text runs past the edge of its narrow container without wrapping at all"
      "\n"
      p class="center"
        "centered line"
      "\n"
      p class="right"
        "right aligned"
      "\n"
      p class="indent"
        "The first line is indented, the rest are not, when the paragraph wraps onto more lines."
      "\n"
      p
        u
          "underlined"
        ", "
        b
          "bold"
        ", "
        i
          "italic"
        " and "
        sub
          "sub"
        sup
          "sup"
        "."
      "\n"

