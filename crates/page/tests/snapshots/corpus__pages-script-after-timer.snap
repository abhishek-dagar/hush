== dom ==
#document
  #doctype html
  html
    head
      title
        "Script edits"
      "\n"
      style
        "#status { color: gray } .done { color: green; font-weight: bold }"
      "\n"
    body
      p id="status" class="done"
        "Timer fired"
      "\n"
      ul id="list"
        li
          "added on DOMContentLoaded"
        li
          "added by the timer"
      "\n"
      script
        "\n  document.addEventListener('DOMContentLoaded', function () {\n    document.getElementById('status').textContent = 'Loaded';\n    var item = document.createElement('li');\n    item.textContent = 'added on DOMContentLoaded';\n    document.getElementById('list').appendChild(item);\n  });\n  setTimeout(function () {\n    var status = document.getElementById('status');\n    status.textContent = 'Timer fired';\n    status.className = 'done';\n    var item = document.createElement('li');\n    item.textContent = 'added by the timer';\n    document.getElementById('list').appendChild(item);\n  }, 100);\n"
      "\n"

