---
source: crates/page/tests/corpus.rs
expression: "dumps(&page, &list)"
---
== dom ==
#document
  #doctype html
  html
    head
      title
        "Custom properties"
      "\n"
      style
        "\n  :root { --accent: #c33; --gap: 8px; --pad: calc(var(--gap) * 2) }\n  body { margin: var(--gap) }\n  .card { --accent: #36c; border: 2px solid var(--accent); padding: var(--gap) }\n  .title { color: var(--accent) }\n  .fallback { color: var(--missing, #393) }\n  .cycle { --a: var(--b); --b: var(--a); color: var(--a, red) }\n  .invalid { --size: nope; margin-left: var(--size) }\n  .inherited { color: var(--accent) }\n"
      "\n"
    body
      p class="title"
        "root accent"
      "\n"
      div class="card"
        p class="title"
          "card accent overrides"
        p class="inherited"
          "inherits the card's value"
      "\n"
      p class="fallback"
        "fallback used"
      "\n"
      p class="cycle"
        "a cycle is invalid at computed value time"
      "\n"
      p class="invalid"
        "an invalid value falls back to the initial margin"
      "\n"

